# Copy this file to .env. Process environment variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
JSON_BODY_LIMIT_BYTES=65536
SHUTDOWN_TIMEOUT_MS=10000

# Exact frontend origins, separated by commas. Empty = no cross-origin access.
# Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Relative paths resolve from backend/, not the shell working directory.
# Persistent default; :memory: is for tests only and rejected in production.
DATABASE_PATH=storage/docuai.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000

# Milestone 5: a key is required ONLY when starting live AI analysis.
# Get one from Google AI Studio; NEVER commit it or share it with the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Milestone 4 still requires ffmpeg and ffprobe available on PATH.
