# The friend's Milestone 5 backend is the default, even without an .env file.
# Use demo for an offline sample; document profile targets the original future API.
VITE_API_MODE=live
VITE_BACKEND_PROFILE=milestone5
# Origin only, without /api. Empty uses same-origin Vite proxy.
VITE_API_BASE_URL=
# Development proxy target; change to match your backend.
API_PROXY_TARGET=http://127.0.0.1:3000
